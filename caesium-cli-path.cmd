@echo off
rem Caesium Image Compressor - command line control
rem
rem This wrapper lives in the dedicated single-file bin folder
rem (%LOCALAPPDATA%\CaesiumImageCompressor\bin). It reads the real executable
rem location from "app-path.txt" next to it, so the PATH entry keeps working
rem even if the application is moved to a new folder.
rem
rem The installer places this file into the bin folder and writes app-path.txt;
rem the application also (re)writes it on every startup and on "Add to PATH".
rem
rem NOTE: Keep this file in sync with the wrapper generated by
rem CliPathConfig::ensureWrapper() in src/utils/CliPathConfig.cpp.
setlocal
set "BINDIR=%~dp0"
set "APPPATH="
if exist "%BINDIR%app-path.txt" (
    set /p APPPATH=<"%BINDIR%app-path.txt"
)
if not defined APPPATH (
    set "APPPATH=%BINDIR%Caesium Image Compressor.exe"
)
if not exist "%APPPATH%" (
    echo Error: could not find "Caesium Image Compressor.exe" at "%APPPATH%" 1>&2
    echo Start the application once so the PATH entry is refreshed. 1>&2
    exit /b 1
)
set "OUTFILE=%TEMP%\caesium-cli-%RANDOM%-%RANDOM%.out"
"%APPPATH%" --cli %* > "%OUTFILE%" 2>&1
set "EXIT_CODE=%ERRORLEVEL%"
if exist "%OUTFILE%" (
    type "%OUTFILE%"
    del "%OUTFILE%" >nul 2>&1
)
exit /b %EXIT_CODE%
